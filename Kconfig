menu "PDM & Encoder audio demo"

# The application image always includes the Opus encoder (CONFIG_OPUS=y
# in the base configs). Opus is fixed-point only, so no FPU is needed.

choice
	prompt "PCM sample rate"
	default PDM_DEMO_SAMPLE_RATE_16000
	help
	  PCM sample rate produced by the PDM/DMIC path and fed to the Opus
	  encoder. 48 kHz is not offered: it exceeds the Opus CPU budget
	  (stereo) and has no exact clock from 32 MHz. Of the remaining
	  rates only 8/16 kHz have an exact PDM clock; 12/24 kHz land
	  ~0.6-0.8% off and 24 kHz stereo is marginal on CPU. A
	  build-time assert in opus_enc.c rejects combinations whose
	  encode estimate exceeds 75% of the block period.

config PDM_DEMO_SAMPLE_RATE_8000
	bool "8 kHz"

config PDM_DEMO_SAMPLE_RATE_12000
	bool "12 kHz"

config PDM_DEMO_SAMPLE_RATE_16000
	bool "16 kHz"

config PDM_DEMO_SAMPLE_RATE_24000
	bool "24 kHz"

endchoice

# Numeric form of the choice above, for arithmetic in the code.
config PDM_DEMO_SAMPLE_RATE
	int
	default 8000 if PDM_DEMO_SAMPLE_RATE_8000
	default 12000 if PDM_DEMO_SAMPLE_RATE_12000
	default 16000 if PDM_DEMO_SAMPLE_RATE_16000
	default 24000 if PDM_DEMO_SAMPLE_RATE_24000

choice
	prompt "PDM channel configuration"
	default PDM_DEMO_STEREO
	help
	  Stereo captures both PDM channels as interleaved 16-bit PCM.
	  Mono captures one of the two PDM_CLK half-cycle slots; pick the
	  edge matching the external microphone SEL strap (see the
	  options' help text).

config PDM_DEMO_STEREO
	bool "Stereo (interleaved left/right)"

config PDM_DEMO_MONO_RISING_EDGE
	bool "Mono, rising-edge slot (SEL-low microphone)"
	help
	  Capture the microphone whose data is valid on the rising edge
	  of PDM_CLK - the one with SEL/LR strapped to GND ("left" in
	  most microphone datasheets).

config PDM_DEMO_MONO_FALLING_EDGE
	bool "Mono, falling-edge slot (SEL-high microphone)"
	help
	  Capture the microphone whose data is valid on the falling edge
	  of PDM_CLK - the one with SEL/LR strapped to VDD ("right" in
	  most microphone datasheets).

endchoice

choice
	prompt "PCM DMA block duration"
	default PDM_DEMO_BLOCK_MS_20
	help
	  Each block is encoded as exactly one Opus frame, so only legal
	  Opus frame durations are offered. Smaller blocks wake the CPU
	  more often during capture.

config PDM_DEMO_BLOCK_MS_5
	bool "5 ms"

config PDM_DEMO_BLOCK_MS_10
	bool "10 ms"

config PDM_DEMO_BLOCK_MS_20
	bool "20 ms"

config PDM_DEMO_BLOCK_MS_40
	bool "40 ms"

config PDM_DEMO_BLOCK_MS_60
	bool "60 ms"

endchoice

# Numeric form of the choice above, for arithmetic in the code.
config PDM_DEMO_BLOCK_MS
	int
	default 5 if PDM_DEMO_BLOCK_MS_5
	default 10 if PDM_DEMO_BLOCK_MS_10
	default 20 if PDM_DEMO_BLOCK_MS_20
	default 40 if PDM_DEMO_BLOCK_MS_40
	default 60 if PDM_DEMO_BLOCK_MS_60

# The number of PCM DMA blocks is not a Kconfig: it is derived from the
# devicetree `queue-size` property of the pdm20 node (single source of
# truth, see pdm_capture.c).

config PDM_DEMO_OPUS_COMPLEXITY
	int "Opus encoder complexity (0-10)"
	default 0
	range 0 10
	help
	  Opus complexity setting. Higher values cost more CPU: complexity
	  10 is far from real time on a 128 MHz Cortex-M33 (~250 ms per
	  20 ms stereo frame), keep at 0 for this demo.

config PDM_DEMO_GAIN_DB
	int "Digital gain on PCM before Opus encoding (dB)"
	default 0
	range 0 40
	help
	  Fixed-point gain applied to every PCM sample ahead of the Opus
	  encoder (gain after compression would need a decode/gain/re-encode
	  round trip). 6 dB doubles the amplitude. Too much gain clips loud
	  sounds (samples saturate at int16 range).

config PDM_DEMO_REC_SECONDS
	int "Maximum recording length (seconds)"
	default 300
	range 1 3600
	help
	  Recording is toggled with Button 0; this is the safety cap at
	  which a recording stops and the file is saved automatically,
	  so a forgotten recording cannot fill the flash.

config PDM_DEMO_PDM_ONLY
	bool "PDM + Opus only power baseline (no storage, LED or BLE)"
    default n
	help
	  Pure PDM capture + Opus encoding mode for power measurement:
	  the encoded frames are discarded, and recording to flash, the
	  LED and BLE/SMP are all compiled out. Used by prj_pdm_only.conf,
	  which also disables serial/logging. The base configuration must
	  not enable FILE_SYSTEM or BT when this is set.

# The Opus encoder state is malloc'ed at startup (measured 43308 bytes
# at 16 kHz stereo, fixed-point), in all configurations including
# pdm_only (encoder created but its output discarded).
config HEAP_MEM_POOL_SIZE
	default 131072

# opus_encode() uses alloca for temporary buffers; the float path
# overflowed a 24 KB main stack in testing.
config MAIN_STACK_SIZE
	default 65536

endmenu

source "Kconfig.zephyr"
