/*
 * nRF54L15DK PDM Opus recorder.
 *
 * PDM20:
 *   CLK: P1.12
 *   DIN: P1.11
 *
 * PDM capture starts automatically after boot.
 */

/* LittleFS auto-mounts at /lfs1. */
/ {
	fstab {
		compatible = "zephyr,fstab";

		lfs1: lfs1 {
			compatible = "zephyr,fstab,littlefs";
			mount-point = "/lfs1";
			partition = <&lfs1_partition>;
			automount;
			/* Program in full 256-byte MX25R64 flash pages:
			 * 16-byte progs turn one 4 KB Ogg page write into
			 * 256 page-program commands (~100-180 ms), stalling
			 * the capture loop and burning power.
			 * NOTE: cache-size is a required binding property, but
			 * Zephyr sizes the file-cache heap from
			 * CONFIG_FS_LITTLEFS_CACHE_SIZE only - keep the two
			 * in sync or fs_open fails with ENOMEM. */
			read-size = <16>;
			prog-size = <256>;
			cache-size = <512>;
			lookahead-size = <32>;
			block-cycles = <512>;
		};
	};
};

/* External flash (MX25R64 on spi00): whole 8 MB for LittleFS.
 * Raise the clock to the SPIM00 maximum (128 MHz core / 4) to shorten
 * fs_write stalls. */
&mx25r64 {
	spi-max-frequency = <32000000>;
	zephyr,pm-device-runtime-auto;

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		lfs1_partition: partition@0 {
			label = "lfs1_partition";
			reg = <0x00000000 0x00800000>;
		};
	};
};

&pdm20 {
	status = "okay";
	pinctrl-0 = <&pdm20_default_pdm_demo>;
	pinctrl-1 = <&pdm20_sleep_pdm_demo>;
	pinctrl-names = "default", "sleep";
	clock-source = "PCLK32M";
	queue-size = <16>;
	zephyr,pm-device-runtime-auto;

	pdm20_dmic: dmic {
		compatible = "zephyr,pdm-dmic";
		status = "okay";
		/* Force 800 kHz / ratio 50 for exact 16 kHz PCM from PCLK32M. */
		clk-frequency-min = <795000>;
		clk-frequency-max = <805000>;
		clk-duty-cycle-min = <40>;
		clk-duty-cycle-max = <60>;
		channel-left;
		channel-right;
	};
};

/* Button 0 (P1.13): use the GPIO sense mechanism (port event) for edge
 * detection instead of a GPIOTE pin-event channel.
 */
&gpio1 {
	sense-edge-mask = <BIT(13)>;
};

/* Runtime PM for the console UART and the external-flash SPI bus;
 * the drivers resume them on demand (log TX / fs access). */
&uart20 {
	zephyr,pm-device-runtime-auto;
};

&spi00 {
	zephyr,pm-device-runtime-auto;
};

&pinctrl {
	pdm20_default_pdm_demo: pdm20_default_pdm_demo {
		group1 {
			psels = <NRF_PSEL(PDM_CLK, 1, 12)>,
					<NRF_PSEL(PDM_DIN, 1, 11)>;
			nordic,drive-mode = <NRF_DRIVE_H0H1>;
		};
	};

	pdm20_sleep_pdm_demo: pdm20_sleep_pdm_demo {
		group1 {
			psels = <NRF_PSEL(PDM_CLK, 1, 12)>,
					<NRF_PSEL(PDM_DIN, 1, 11)>;
			low-power-enable;
		};
	};
};
